# Copie para .env e informe os dados da sua instalação MySQL/MariaDB.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=arte_guiada
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Sobrescreve DB_NAME no processo em que for definida.
# ARTE_GUIADA_DB_NAME=arte_guiada_test

# E-mail da conta Editor usada pelo importador de demonstração (opcional).
# ARTE_GUIADA_EDITOR_EMAIL=editor@exemplo.com

# Primeiro administrador da instalação.
# Utilizado exclusivamente por scripts/criar-admin-inicial.php.
ADMIN_BOOTSTRAP_NOME=
ADMIN_BOOTSTRAP_SOBRENOME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_SENHA=
