# Texto versionado com finais de linha uniformes em qualquer sistema operacional.
* text=auto eol=lf

# Conteúdo binário não deve passar por conversão de finais de linha.
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.woff binary
*.woff2 binary
