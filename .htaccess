Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env(\..*)?|\.gitignore|\.gitattributes|composer\.(json|lock)|phpunit(\.restore)?\.xml|router\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:config|database|docs|logs|tests|vendor|\.git)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]
</IfModule>
